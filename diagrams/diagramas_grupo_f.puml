' ────────────────────────────────────────────────────────────────
'  DIAGRAMA 6 — Entidad-Relación MySQL
' ────────────────────────────────────────────────────────────────
@startuml Diagrama_6_ER_Database
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam classHeaderBackgroundColor #0D1F4E
skinparam classHeaderFontColor #FFFFFF
skinparam classBorderColor #2462B0
skinparam classBackgroundColor #FFFFFF
skinparam classFontColor #000000
skinparam classAttributeFontSize 9
skinparam ArrowColor #2462B0
skinparam ArrowThickness 1.5
skinparam packageBorderColor #D4A843
skinparam linetype ortho

title <b>UNI-VIRTUAL v8 — Diagrama Entidad-Relación\nBase de Datos MySQL (17 tablas)</b>

entity "usuarios" as U {
  * idUsuario : INT <<PK>>
  --
  nombre : VARCHAR(100)
  email : VARCHAR(100) <<UNIQUE>>
  password : VARCHAR(255) <<bcrypt>>
  rol : ENUM(estudiante|profesor|directivo|admin)
  activo : TINYINT(1)
  creado_en : TIMESTAMP
}

entity "facultades" as FAC {
  * idFacultad : INT <<PK>>
  --
  nombre : VARCHAR(150)
  codigo : VARCHAR(20) <<UNIQUE>>
  activa : TINYINT(1)
}

entity "carreras" as CAR {
  * idCarrera : INT <<PK>>
  --
  idFacultad : INT <<FK>>
  nombre : VARCHAR(150)
  codigo : VARCHAR(20) <<UNIQUE>>
  creditos_total : INT
}

entity "directivos" as DIR {
  * idDirectivo : INT <<PK>>
  --
  idUsuario : INT <<FK>>
  idFacultad : INT <<FK>>
  cargo : VARCHAR(100)
}

entity "estudiantes" as EST {
  * idEstudiante : INT <<PK>>
  --
  idUsuario : INT <<FK>>
  idCarrera : INT <<FK>>
  codigoEst : VARCHAR(20) <<UNIQUE>>
  semestre : INT
  creditos_aprobados : INT
}

entity "profesores" as PRO {
  * idProfesor : INT <<PK>>
  --
  idUsuario : INT <<FK>>
  idFacultad : INT <<FK>>
  codigoProf : VARCHAR(20) <<UNIQUE>>
  departamento : VARCHAR(100)
}

entity "materias" as MAT {
  * idMateria : INT <<PK>>
  --
  idProfesor : INT <<FK>>
  idCarrera : INT <<FK>>
  nombre : VARCHAR(150)
  codigo : VARCHAR(20) <<UNIQUE>>
  creditos : INT
  creditos_minimos : INT
  color : VARCHAR(7)
  activa : TINYINT(1)
}

entity "inscripciones" as INS {
  * idInscripcion : INT <<PK>>
  --
  idEstudiante : INT <<FK>>
  idMateria : INT <<FK>>
  inscrito_en : TIMESTAMP
  nota_parcial1 : DECIMAL(3,2)
  nota_parcial2 : DECIMAL(3,2)
  nota_talleres : DECIMAL(3,2)
  nota_final : DECIMAL(3,2)
  --
  <<UNIQUE>> idEstudiante+idMateria
}

entity "aulas_virtuales" as AV {
  * idAula : INT <<PK>>
  --
  idMateria : INT <<FK>>
  creada_en : TIMESTAMP
  --
  <<UNIQUE>> idMateria
}

entity "materiales" as MATL {
  * idMaterial : INT <<PK>>
  --
  idAula : INT <<FK>>
  idProfesor : INT <<FK>>
  titulo : VARCHAR(150)
  tipo : ENUM(pdf|video|presentacion|otro)
  urlArchivo : VARCHAR(500)
  nombreOriginal : VARCHAR(255)
  descargas : INT
}

entity "actividades" as ACT {
  * idActividad : INT <<PK>>
  --
  idAula : INT <<FK>>
  titulo : VARCHAR(150)
  fechaEntrega : DATETIME
  puntaje_max : DECIMAL(4,2)
}

entity "entregas" as ENT {
  * idEntrega : INT <<PK>>
  --
  idActividad : INT <<FK>>
  idEstudiante : INT <<FK>>
  urlArchivo : VARCHAR(500)
  nota : DECIMAL(3,2)
  feedback : TEXT
  entregado_en : TIMESTAMP
  --
  <<UNIQUE>> idActividad+idEstudiante
}

entity "foros" as FOR {
  * idForo : INT <<PK>>
  --
  idAula : INT <<FK>>
  titulo : VARCHAR(150)
  abierto : TINYINT(1)
}

entity "mensajes" as MSG {
  * idMensaje : INT <<PK>>
  --
  idForo : INT <<FK>>
  idUsuario : INT <<FK>>
  idPadre : INT <<FK, nullable>>
  contenido : TEXT
  publicado_en : TIMESTAMP
}

entity "asistencia" as ASI {
  * idAsistencia : INT <<PK>>
  --
  idMateria : INT <<FK>>
  idEstudiante : INT <<FK>>
  fecha : DATE
  asistio : TINYINT(1)
  --
  <<UNIQUE>> idMateria+idEstudiante+fecha
}

entity "notificaciones" as NOT {
  * idNotif : INT <<PK>>
  --
  idUsuario : INT <<FK>>
  titulo : VARCHAR(150)
  tipo : ENUM(info|tarea|nota|foro|material|videollamada)
  url : VARCHAR(500)
  leida : TINYINT(1)
  creado_en : TIMESTAMP
}

entity "videollamadas" as VL {
  * idVideoLlamada : INT <<PK>>
  --
  idMateria : INT <<FK>>
  idProfesor : INT <<FK>>
  titulo : VARCHAR(200)
  roomName : VARCHAR(200) <<UNIQUE>>
  programada_en : DATETIME
  duracion_min : INT
  estado : ENUM(programada|en_curso|finalizada)
  activa : TINYINT(1)
}

entity "configuracion" as CFG {
  * clave : VARCHAR(80) <<PK>>
  --
  valor : TEXT
  tipo : ENUM(texto|numero|booleano|json)
  descripcion : VARCHAR(200)
}

