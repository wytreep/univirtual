CAR |o--|{ MAT  : "pertenece"
MAT }|--|| PRO  : "imparte"

INS }o--|| EST  : "inscribe"
INS }o--|| MAT  : "en"

MAT ||--|| AV   : "tiene"
AV  ||--|{ MATL : "contiene"
AV  ||--|{ ACT  : "contiene"
AV  ||--|{ FOR  : "contiene"

ACT ||--|{ ENT  : "recibe"
EST ||--|{ ENT  : "envía"

FOR ||--|{ MSG  : "contiene"
U   ||--|{ MSG  : "publica"
MSG |o--o| MSG  : "responde"

U   ||--|{ NOT  : "recibe"
MAT ||--|{ VL   : "tiene"
PRO ||--|{ VL   : "crea"
MAT ||--|{ ASI  : "registra"
EST ||--|{ ASI  : "de"
@enduml
