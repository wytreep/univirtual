' ────────────────────────────────────────────────────────────────
'  DIAGRAMA 1 — Arquitectura del Sistema (Flujo de Peticiones)
' ────────────────────────────────────────────────────────────────
@startuml Diagrama_1_Arquitectura_Sistema
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #2462B0
skinparam ArrowThickness 1.5
skinparam componentBorderColor #2462B0
skinparam componentBackgroundColor #EEF3FB
skinparam componentFontColor #0D1F4E
skinparam componentFontStyle bold
skinparam packageBorderColor #D4A843
skinparam packageBackgroundColor #FFFDF0
skinparam packageFontColor #7A5C00
skinparam packageFontStyle bold
skinparam actorBorderColor #0D1F4E
skinparam actorBackgroundColor #EEF3FB
skinparam actorFontColor #0D1F4E
skinparam noteBorderColor #D4A843
skinparam noteBackgroundColor #FFFDF0
skinparam databaseBorderColor #1A7A48
skinparam databaseBackgroundColor #E8F5EE

title <b>UNI-VIRTUAL v8 — Arquitectura del Sistema\nFlujo completo de una petición HTTP</b>

actor "Admin"      as ADM #EEF3FB
actor "Directivo"  as DIR #FFF8E1
actor "Profesor"   as PRO #E8F5EE
actor "Estudiante" as EST #F3E8FF

package "Capa 1 — Cliente (Browser)" #EEF3FB {
  component "React 18 SPA\n(Babel CDN)" as REACT
  component "fetch() API\ncredentials:'include'" as FETCH
  component "Chart.js 4\ngráficos" as CHART
}

package "Capa 2 — Servidor XAMPP / Apache" #FFF8E1 {
  package "Views — PHP (MVC-V)" {
    component "login.php\nlogout.php" as VAUTH
    component "admin/\ndashboard.php" as VADM
    component "directivo/\ndashboard.php" as VDIR
    component "profesor/\ndashboard.php" as VPRO
    component "estudiante/\ndashboard.php" as VEST
  }
  package "Controllers — API REST (MVC-C)" {
    component "Controller.php\n(abstracto base)" as CTRL
    component "stats.php\nusuarios.php\nmaterias.php" as C1
    component "profesor.php\nestudiante.php\ninscripciones.php" as C2
    component "videollamadas.php\nreportes.php" as C3
  }
  package "Models — PHP POO (MVC-M)" {
    component "Model.php\n(Singleton PDO)" as MODEL
    component "Usuario · Estudiante\nProfesor · Materia" as M1
    component "Material · Actividad\nEntrega · Foro" as M2
    component "Notificacion · Asistencia\nMensaje · Videollamada" as M3
  }
  package "Config & Auth" {
    component "config.php\ndb() · notificar()" as CFG
    component "auth.php\nrequireLogin()\nrequireNivel()" as AUTH
  }
}

package "Capa 3 — Persistencia" #E8F5EE {
  database "MySQL 8\nuniverse:3307\n17 tablas" as DB
}

package "Servicios Externos" #F3E8FF {
  component "meet.jit.si\nJitsi Meet (WebRTC)" as JITSI
  component "Google Fonts\nunpkg CDN" as CDN
}

ADM --> VAUTH
DIR --> VAUTH
PRO --> VAUTH
EST --> VAUTH
VAUTH --> CFG
VAUTH --> AUTH

VADM --> REACT
VDIR --> REACT
VPRO --> REACT
VEST --> REACT
REACT --> CHART
REACT --> CDN

REACT --> FETCH
FETCH --> CTRL : "JSON request\n+ cookies PHP"

CTRL --> AUTH   : "requireAuth(rol)"
CTRL --> C1
CTRL --> C2
CTRL --> C3

C1 --> MODEL
C2 --> MODEL
C3 --> MODEL

MODEL --> M1
MODEL --> M2
MODEL --> M3
M1 --> DB
M2 --> DB
M3 --> DB

C3 --> JITSI : "roomName → URL"
REACT --> JITSI : "Abrir sala"

note right of CTRL
  Admin siempre pasa requireAuth.
  <b>FIX v8:</b> videollamadas.php lee
  action del JSON body:
  $_jsonBody = json_decode(
    file_get_contents('php://input')
  );
  $action = $_GET['action']
    ?? $_POST['action']
    ?? $_jsonBody['action'] ?? '';
end note

note bottom of DB
  <b>Restricciones clave:</b>
  UNIQUE(idMateria,idEstudiante,fecha) — asistencia
  UNIQUE(idEstudiante,idMateria) — inscripciones
  UNIQUE roomName — videollamadas
  Puerto 3307 en XAMPP
end note
@enduml

' ────────────────────────────────────────────────────────────────
'  DIAGRAMA 2 — Clases: Capa de Modelos
' ────────────────────────────────────────────────────────────────
@startuml Diagrama_2_Clases_Models
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classHeaderBackgroundColor #0D1F4E
skinparam classHeaderFontColor #FFFFFF
skinparam classBorderColor #2462B0
skinparam classBackgroundColor #FFFFFF
skinparam classFontColor #000000
skinparam classAttributeFontSize 10
skinparam ArrowColor #2462B0
skinparam ArrowThickness 1.5
skinparam packageBorderColor #D4A843
skinparam packageBackgroundColor #FFFDF0

title <b>UNI-VIRTUAL v8 — Diagrama de Clases\nCapa de Modelos (MVC — M)</b>

package "models/" #EEF3FB {

  abstract class Model {
    # db : PDO <<Singleton>>
    --
    + {abstract} findById(id: int) : array|null
    + {abstract} findAll() : array
    # db() : PDO
  }

  class Usuario {
    + idUsuario : int <<PK>>
    + nombre : string
    + email : string <<UNIQUE>>
    + password : string <<bcrypt>>
    + rol : enum
    + activo : bool
    + creado_en : timestamp
    --
    + findByEmail(email) : array|null
    + verificarPassword(pass, hash) : bool
    + crear(nombre, email, pass, rol) : int
    + setActivo(id, activo) : void
  }

  class Estudiante {
    + idEstudiante : int <<PK>>
    + idUsuario : int <<FK>>
    + idCarrera : int <<FK>>
    + codigoEst : string <<UNIQUE>>
    + semestre : int
    + creditos_aprobados : int
    --
    + findByUsuario(idUsuario) : array|null
    + getMaterias() : array
    + getNotas() : array
  }

  class Profesor {
    + idProfesor : int <<PK>>
    + idUsuario : int <<FK>>
    + idFacultad : int <<FK>>
    + codigoProf : string <<UNIQUE>>
    + departamento : string
    --
    + findByUsuario(idUsuario) : array|null
    + getMaterias() : array
  }

  class Materia {
    + idMateria : int <<PK>>
    + idProfesor : int <<FK>>
    + nombre : string
    + codigo : string <<UNIQUE>>
    + creditos : int
    + creditos_minimos : int
    + color : string
    + activa : bool
    --
    + getInscritos() : array
    + getAula() : array|null
  }

  class Material {
    + idMaterial : int <<PK>>
    + idAula : int <<FK>>
    + titulo : string
    + tipo : enum
    + urlArchivo : string
    + nombreOriginal : string
    + descargas : int
    --
    + findByAula(idAula) : array
    + incrementarDescargas() : void
  }

  class Actividad {
    + idActividad : int <<PK>>
    + idAula : int <<FK>>
    + titulo : string
    + fechaEntrega : datetime
    + puntaje_max : decimal
    --
    + findByAula(idAula) : array
    + getEntregas() : array
  }

  class Entrega {
    + idEntrega : int <<PK>>
    + idActividad : int <<FK>>
    + idEstudiante : int <<FK>>
    + urlArchivo : string
    + nota : decimal
    + feedback : text
    + entregado_en : timestamp
    --
    + calificar(nota, feedback) : bool
  }

  class Foro {
    + idForo : int <<PK>>
    + idAula : int <<FK>>
    + titulo : string
    + abierto : bool
    --
    + findByAula(idAula) : array
    + getMensajes() : array
  }

  class Mensaje {
    + idMensaje : int <<PK>>
    + idForo : int <<FK>>
    + idUsuario : int <<FK>>
    + idPadre : int <<FK, nullable>>
    + contenido : text
    + publicado_en : timestamp
    --
    + findByForo(idForo) : array
    + getRespuestas() : array
  }

  class Asistencia {
    + idAsistencia : int <<PK>>
    + idMateria : int <<FK>>
    + idEstudiante : int <<FK>>
    + fecha : date
    + asistio : bool
    -- <<UNIQUE>> idMateria+idEstudiante+fecha --
    + registrar(idMat, idEst, fecha, val) : void
    + getPorFecha(idMat, fecha) : array
  }

  class Notificacion {
    + idNotif : int <<PK>>
    + idUsuario : int <<FK>>
    + titulo : string
    + tipo : enum
    + url : string
    + leida : bool
    + creado_en : timestamp
    --
    + findByUsuario(idUser) : array
    + marcar(idNotif) : void
    + marcarTodas(idUser) : void
  }
}

Model <|-- Usuario
Model <|-- Estudiante
Model <|-- Profesor
Model <|-- Materia
Model <|-- Material
Model <|-- Actividad
Model <|-- Entrega
Model <|-- Foro
Model <|-- Mensaje
Model <|-- Asistencia
Model <|-- Notificacion

Estudiante  --> Usuario   : idUsuario
Profesor    --> Usuario   : idUsuario
Entrega     --> Actividad : idActividad
Entrega     --> Estudiante : idEstudiante
Mensaje     --> Foro      : idForo
Mensaje     --> Usuario   : idUsuario
Mensaje     --> Mensaje   : idPadre
Notificacion --> Usuario  : idUsuario
Asistencia  --> Materia   : idMateria
Asistencia  --> Estudiante : idEstudiante
@enduml

' ────────────────────────────────────────────────────────────────
'  DIAGRAMA 3 — Clases: Capa de Controladores (API REST)
' ────────────────────────────────────────────────────────────────
@startuml Diagrama_3_Clases_Controllers
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classHeaderBackgroundColor #0D1F4E
skinparam classHeaderFontColor #FFFFFF
skinparam classBorderColor #2462B0
skinparam classBackgroundColor #FFFFFF
skinparam classFontColor #000000
skinparam classAttributeFontSize 10
skinparam ArrowColor #2462B0
skinparam ArrowThickness 1.5
skinparam packageBorderColor #D4A843

title <b>UNI-VIRTUAL v8 — Diagrama de Clases\nCapa de Controladores REST (MVC — C)</b>

package "api/v1/" #EEF3FB {

  abstract class Controller {
    + {abstract} handle() : void
    # requireAuth(rol) : array
    # ok(data, msg) : void
    # error(msg, code) : void
    # getBody() : array
    # method() : string
    --
    <b>Admin siempre pasa requireAuth</b>
    <b>Admin accede a cualquier endpoint</b>
  }

  class StatsController {
    + handle() : void
    - dashboard() : void
    - facultad() : void
    --
    GET ?action=dashboard
    GET ?action=facultad&idFacultad=1
  }

  class UsuarioController {
    - modelo : Usuario
    + handle() : void
    - getAll() : void
    - getOne(id) : void
    - crear() : void
    - actualizar(id) : void
    - eliminar(id) : void
    - profesoresFacultad() : void
    - estudiantesFacultad() : void
    --
    GET · POST · PUT · DELETE
    GET ?action=profesores_facultad
    GET ?action=estudiantes_facultad
  }

  class MateriaController {
    + handle() : void
    - getAll() : void
    - getProfesores() : void
    - listarFacultad() : void
    - crear() : void
    - actualizar(id) : void
    - eliminar(id) : void
    --
    GET · POST · PUT · DELETE
    GET ?action=profesores
    GET ?action=listar_facultad
  }

  class InscripcionesController {
    + handle() : void
    - getInscripciones() : void
    - inscribir() : void
    - desinscribir() : void
    --
    GET ?idMateria=1 (inscritos)
    GET ?disponibles=1&idMateria=1
    <b>FIX: NOT IN excluye ya inscritos</b>
    POST {idEstudiante, idMateria}
    <b>FIX: valida creditos_minimos</b>
    DELETE ?idEstudiante&idMateria
  }

  class ProfesorController {
    - idProfesor : int
    - idUsuario : int
    + handle() : void
    - dashboard() : void
    - aula() : void
    - entregas() : void
    - asistenciaFecha() : void
    - notificaciones() : void
    - subirMaterial() : void
    - crearActividad() : void
    - calificarEntrega() : void
    - registrarAsistencia() : void
    - marcarNotifs() : void
    - actualizarPerfil() : void
    - cambiarPassword() : void
    --
    <b>FIX: entregas() usa urlArchivo</b>
    <b>FIX: asistencia ON DUPLICATE KEY</b>
  }

  class EstudianteController {
    - idEstudiante : int
    - idUsuario : int
    + handle() : void
    - dashboard() : void
    - aula() : void
    - notas() : void
    - notificaciones() : void
    - publicarMensaje() : void
    - entregar() : void
    - marcarNotifs() : void
    --
    GET: dashboard|aula|notas
    GET: notificaciones (polling 30s)
    POST: publicar_mensaje|entregar
  }

  class VideoLlamadaController {
    <<procedimental>>
    + handle() : void
    --
    GET ?action=lista[&idMateria]
    GET ?action=activa&idMateria
    POST action=crear
    POST action=finalizar
    POST action=eliminar
    <b>FIX 400: lee action del JSON body</b>
    $_jsonBody = json_decode(input)
    $action = GET ?? POST ?? body
  }

  class ReportesController {
    + handle() : void
    - notasPDF() : void
    - notasCSV() : void
    - asistenciaPDF() : void
    --
    GET ?idMateria&formato=pdf|csv|xlsx
  }
}

Controller <|-- StatsController
Controller <|-- UsuarioController
Controller <|-- MateriaController
Controller <|-- InscripcionesController
Controller <|-- ProfesorController
Controller <|-- EstudianteController
Controller <|-- ReportesController

note bottom of VideoLlamadaController
  No hereda de Controller.
  Script procedimental con
  helpers propios ok() y err().
end note
@enduml

